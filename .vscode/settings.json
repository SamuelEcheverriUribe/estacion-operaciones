{
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "yaml": true
  },
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "files.exclude": {
    "**/.godot": true
  }
}